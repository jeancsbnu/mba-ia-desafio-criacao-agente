# Copie para .env e preencha. O .env não é versionado.

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# FALSE para usar a chave do AI Studio em vez do Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=

# Opcional: modelo Gemini dos agentes (padrão: gemini-3.6-flash)
AURORA_MODELO=
