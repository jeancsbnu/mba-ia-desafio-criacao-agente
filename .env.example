# Copie para .env e preencha. O .env não é versionado.

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# FALSE para usar a chave do AI Studio em vez do Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=

# Opcional: modelos Gemini em ordem de preferência, separados por vírgula.
# Quando um esgota a cota ou está sobrecarregado, a chamada passa ao próximo.
# Padrão: gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
AURORA_MODELOS=
